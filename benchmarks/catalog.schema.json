{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic EDA benchmark catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "categories", "tiers", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tiers": {"type": "array", "items": {"enum": ["smoke", "light", "system", "implementation", "external"]}, "uniqueItems": true},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "family", "variant", "title", "category", "tier", "tool", "origin", "availability", "seed", "timeout_ms", "input", "acceptance"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "family": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "tier": {"enum": ["smoke", "light", "system", "implementation", "external"]},
        "tool": {"enum": ["eda_xsim", "eda_vivado", "eda_ltspice_batch", "node_test"]},
        "origin": {"enum": ["existing", "generated", "external"]},
        "availability": {"enum": ["runnable", "external_not_downloaded"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 900000},
        "negative_control": {"type": "boolean"},
        "input": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["tool", "call_file", "generated", "verilogeval", "fft", "invalid_rtl", "node_test", "timeout_fixture", "external"]}}},
        "acceptance": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["marker", "rc", "verilogeval", "routed", "fft", "expected_failure", "expected_timeout", "node_tests"]}}}
      }
    }
  }
}
