{
  "schema_version": 1,
  "id": "a7-soc-full",
  "goal": "A7-100T soc: fixed functional oracle, 100 MHz implementation, routed interfaces and DRC",
  "inputs": [
    "projects/system-bench/soc/expected.hex",
    "projects/system-bench/soc/firmware.hex"
  ],
  "limits": {
    "max_calls": 4,
    "wall_seconds": 3600
  },
  "steps": [
    {
      "id": "simulation",
      "tool": "eda_xsim",
      "args": {
        "sources": [
          "vendor/picorv32/picorv32.v",
          "projects/system-bench/soc/soc_top.v",
          "projects/system-bench/soc/tb_soc.sv"
        ],
        "top": "tb_soc",
        "capture_top_wave": false,
        "timeout_seconds": 1200,
        "pass_marker": "SYSTEM_BENCH_PASS project=soc"
      },
      "checks": [
        {
          "pointer": "/simulation_acceptance/status",
          "op": "eq",
          "value": "pass"
        }
      ]
    },
    {
      "id": "synthesis",
      "tool": "eda_vivado_synthesize",
      "args": {
        "sources": [
          "vendor/picorv32/picorv32.v",
          "projects/system-bench/soc/soc_top.v"
        ],
        "top": "soc_top",
        "part": "xc7a100tfgg676-2",
        "constraints": [
          "projects/a7-validation/soc-clocks.xdc"
        ]
      },
      "checks": [
        {
          "pointer": "/fpga/black_boxes",
          "op": "eq",
          "value": 0
        }
      ]
    },
    {
      "id": "implementation",
      "tool": "eda_vivado_implement",
      "args": {
        "checkpoint": {
          "$result": {
            "step": "synthesis",
            "pointer": "/fpga/artifacts/synthesized.dcp"
          }
        },
        "constraint_scripts": [
          "projects/a7-validation/ooc-context.tcl"
        ]
      },
      "checks": [
        {
          "pointer": "/fpga/assessment/setup_hold",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/routing",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/clock_and_internal_constraints",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/io_constraints",
          "op": "eq",
          "value": "pass"
        }
      ]
    },
    {
      "id": "drc",
      "tool": "eda_vivado_report_drc",
      "args": {
        "checkpoint": {
          "$result": {
            "step": "implementation",
            "pointer": "/fpga/artifacts/routed.dcp"
          }
        }
      },
      "checks": [
        {
          "pointer": "/fpga/reports/0/status",
          "op": "eq",
          "value": "ok"
        }
      ]
    }
  ],
  "guidance": {
    "sop_ids": [
      "fpga-rtl-verify",
      "fpga-timing-triage"
    ]
  },
  "acceptance": {
    "profile": "fpga_ooc",
    "bindings": {
      "functional": "simulation",
      "synthesis": "synthesis",
      "setup": "implementation",
      "hold": "implementation",
      "constraints": "implementation",
      "routing": "implementation",
      "drc": "drc"
    },
    "design": {
      "top": "soc_top",
      "part": "xc7a100tfgg676-2",
      "clock": "clk",
      "period_ns": 10
    }
  }
}
