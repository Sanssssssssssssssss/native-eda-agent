{
  "schema_version": 1,
  "id": "a7-ethernet-cdc-full-v2",
  "goal": "A7-100T ethernet-cdc: complete fixed functional and physical acceptance with explicit OOC integration context",
  "inputs": [
    "projects/hard-bench/ethernet-cdc/valid.hex",
    "projects/hard-bench/ethernet-cdc/negative.hex",
    "projects/hard-bench/ethernet-cdc/expected.hex",
    "projects/hard-bench/ethernet-cdc/arp.hex",
    "vendor/verilog-ethernet/lib/axis/syn/vivado/axis_async_fifo.tcl",
    "vendor/verilog-ethernet/lib/axis/syn/vivado/sync_reset.tcl",
    "projects/hard-bench/ethernet-cdc/constraints.tcl"
  ],
  "limits": {
    "max_calls": 5,
    "wall_seconds": 3600
  },
  "steps": [
    {
      "id": "clock_a",
      "tool": "eda_xsim",
      "args": {
        "sources": [
          "vendor/verilog-ethernet/rtl/udp_complete.v",
          "vendor/verilog-ethernet/rtl/udp.v",
          "vendor/verilog-ethernet/rtl/udp_checksum_gen.v",
          "vendor/verilog-ethernet/rtl/udp_ip_rx.v",
          "vendor/verilog-ethernet/rtl/udp_ip_tx.v",
          "vendor/verilog-ethernet/rtl/ip_complete.v",
          "vendor/verilog-ethernet/rtl/ip.v",
          "vendor/verilog-ethernet/rtl/ip_eth_rx.v",
          "vendor/verilog-ethernet/rtl/ip_eth_tx.v",
          "vendor/verilog-ethernet/rtl/ip_arb_mux.v",
          "vendor/verilog-ethernet/rtl/arp.v",
          "vendor/verilog-ethernet/rtl/arp_cache.v",
          "vendor/verilog-ethernet/rtl/arp_eth_rx.v",
          "vendor/verilog-ethernet/rtl/arp_eth_tx.v",
          "vendor/verilog-ethernet/rtl/eth_arb_mux.v",
          "vendor/verilog-ethernet/rtl/lfsr.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g_fifo.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_rx.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_tx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_rx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_tx.v",
          "vendor/verilog-ethernet/lib/axis/rtl/arbiter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/priority_encoder.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/sync_reset.v",
          "projects/hard-bench/ethernet-cdc/ethernet_cdc_top.v",
          "projects/hard-bench/ethernet-cdc/tb_a.sv"
        ],
        "top": "tb_ethernet_cdc_a",
        "capture_top_wave": false,
        "pass_marker": "HARD_BENCH_PASS project=ethernet-cdc",
        "timeout_seconds": 900
      },
      "checks": [
        {
          "pointer": "/simulation_acceptance/status",
          "op": "eq",
          "value": "pass"
        }
      ]
    },
    {
      "id": "clock_b",
      "tool": "eda_xsim",
      "args": {
        "sources": [
          "vendor/verilog-ethernet/rtl/udp_complete.v",
          "vendor/verilog-ethernet/rtl/udp.v",
          "vendor/verilog-ethernet/rtl/udp_checksum_gen.v",
          "vendor/verilog-ethernet/rtl/udp_ip_rx.v",
          "vendor/verilog-ethernet/rtl/udp_ip_tx.v",
          "vendor/verilog-ethernet/rtl/ip_complete.v",
          "vendor/verilog-ethernet/rtl/ip.v",
          "vendor/verilog-ethernet/rtl/ip_eth_rx.v",
          "vendor/verilog-ethernet/rtl/ip_eth_tx.v",
          "vendor/verilog-ethernet/rtl/ip_arb_mux.v",
          "vendor/verilog-ethernet/rtl/arp.v",
          "vendor/verilog-ethernet/rtl/arp_cache.v",
          "vendor/verilog-ethernet/rtl/arp_eth_rx.v",
          "vendor/verilog-ethernet/rtl/arp_eth_tx.v",
          "vendor/verilog-ethernet/rtl/eth_arb_mux.v",
          "vendor/verilog-ethernet/rtl/lfsr.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g_fifo.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_rx.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_tx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_rx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_tx.v",
          "vendor/verilog-ethernet/lib/axis/rtl/arbiter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/priority_encoder.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/sync_reset.v",
          "projects/hard-bench/ethernet-cdc/ethernet_cdc_top.v",
          "projects/hard-bench/ethernet-cdc/tb_b.sv"
        ],
        "top": "tb_ethernet_cdc_b",
        "capture_top_wave": false,
        "pass_marker": "HARD_BENCH_PASS project=ethernet-cdc",
        "timeout_seconds": 900
      },
      "checks": [
        {
          "pointer": "/simulation_acceptance/status",
          "op": "eq",
          "value": "pass"
        }
      ]
    },
    {
      "id": "synthesis",
      "tool": "eda_vivado_synthesize",
      "args": {
        "sources": [
          "vendor/verilog-ethernet/rtl/udp_complete.v",
          "vendor/verilog-ethernet/rtl/udp.v",
          "vendor/verilog-ethernet/rtl/udp_checksum_gen.v",
          "vendor/verilog-ethernet/rtl/udp_ip_rx.v",
          "vendor/verilog-ethernet/rtl/udp_ip_tx.v",
          "vendor/verilog-ethernet/rtl/ip_complete.v",
          "vendor/verilog-ethernet/rtl/ip.v",
          "vendor/verilog-ethernet/rtl/ip_eth_rx.v",
          "vendor/verilog-ethernet/rtl/ip_eth_tx.v",
          "vendor/verilog-ethernet/rtl/ip_arb_mux.v",
          "vendor/verilog-ethernet/rtl/arp.v",
          "vendor/verilog-ethernet/rtl/arp_cache.v",
          "vendor/verilog-ethernet/rtl/arp_eth_rx.v",
          "vendor/verilog-ethernet/rtl/arp_eth_tx.v",
          "vendor/verilog-ethernet/rtl/eth_arb_mux.v",
          "vendor/verilog-ethernet/rtl/lfsr.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g_fifo.v",
          "vendor/verilog-ethernet/rtl/eth_mac_1g.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_rx.v",
          "vendor/verilog-ethernet/rtl/axis_gmii_tx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_rx.v",
          "vendor/verilog-ethernet/rtl/eth_axis_tx.v",
          "vendor/verilog-ethernet/lib/axis/rtl/arbiter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/priority_encoder.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo.v",
          "vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo_adapter.v",
          "vendor/verilog-ethernet/lib/axis/rtl/sync_reset.v",
          "projects/hard-bench/ethernet-cdc/ethernet_cdc_top.v"
        ],
        "top": "ethernet_cdc_top",
        "part": "xc7a100tfgg676-2",
        "constraints": [
          "projects/hard-bench/ethernet-cdc/workflow-clocks.xdc"
        ]
      },
      "checks": [
        {
          "pointer": "/fpga/black_boxes",
          "op": "eq",
          "value": 0
        }
      ]
    },
    {
      "id": "implementation",
      "tool": "eda_vivado_implement",
      "args": {
        "checkpoint": {
          "$result": {
            "step": "synthesis",
            "pointer": "/fpga/artifacts/synthesized.dcp"
          }
        },
        "constraint_scripts": [
          "projects/a7-validation/ooc-context.tcl",
          "projects/a7-validation/ethernet-cdc-constraints.tcl"
        ],
        "async_reset_ports": [
          "reset"
        ]
      },
      "checks": [
        {
          "pointer": "/fpga/assessment/setup_hold",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/routing",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/clock_and_internal_constraints",
          "op": "eq",
          "value": "pass"
        },
        {
          "pointer": "/fpga/assessment/io_constraints",
          "op": "eq",
          "value": "pass"
        }
      ]
    },
    {
      "id": "drc",
      "tool": "eda_vivado_report_drc",
      "args": {
        "checkpoint": {
          "$result": {
            "step": "implementation",
            "pointer": "/fpga/artifacts/routed.dcp"
          }
        }
      },
      "checks": [
        {
          "pointer": "/fpga/reports/0/status",
          "op": "eq",
          "value": "ok"
        }
      ]
    }
  ],
  "guidance": {
    "sop_ids": [
      "fpga-rtl-verify",
      "fpga-timing-triage"
    ]
  },
  "acceptance": {
    "profile": "fpga_ooc",
    "bindings": {
      "functional": "clock_b",
      "synthesis": "synthesis",
      "setup": "implementation",
      "hold": "implementation",
      "constraints": "implementation",
      "routing": "implementation",
      "drc": "drc"
    },
    "design": {
      "top": "ethernet_cdc_top",
      "part": "xc7a100tfgg676-2",
      "clock": "logic_clk",
      "period_ns": 10
    }
  }
}
